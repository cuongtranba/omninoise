    "@remotion/three": "4.0.513",
    "@remotion/transitions": "4.0.513",
    "@xyflow/react": "^12.11.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.513",
    "three": "^0.185.1"
  },
  "devDependencies": {
