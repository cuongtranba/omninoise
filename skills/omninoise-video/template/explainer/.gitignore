node_modules/
out/
.env
.DS_Store

# src/generated/ IS committed. It is machine-owned but it is also what makes a
# fresh clone type-check and open in Studio before `nv sync` has ever run.

# Voiceover audio is not committed: the mp3 takes are regenerated with
# scripts/voiceover-timestamps.ts, which spends ElevenLabs characters. The manifests and
# alignment.json files in public/voiceover/<locale>/ are kept.
public/voiceover/**/*.mp3

# Codex art: the raw pictures and transcripts stay local; public/art/ and art/manifest.json are committed.
art/raw/
art/logs/
