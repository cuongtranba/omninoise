# Variables read by deploy/compose.yaml. Real values are set in the Dokploy
# compose environment only. Never commit a filled-in copy of this file.

# Image tag. Set by the deploy workflow, not in Dokploy.
IMAGE_TAG=sha-0000000

# Public hostname Postiz is served from (no scheme).
POSTIZ_HOST=postiz.example.com
# Signing secret for Postiz sessions. Generate a long random string.
JWT_SECRET=
# Postiz application database user.
DB_USER=
# Postiz application database password.
DB_PASSWORD=
# Postiz application database name.
DB_NAME=
# true closes sign-up after the first account exists. Defaults to true.
DISABLE_REGISTRATION=
# Public API requests allowed per hour. Defaults to 30.
API_LIMIT=

# Facebook page publishing (Meta app "Omninoise").
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Instagram Reels publishing.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Threads publishing (Threads use case on the Meta app).
THREADS_APP_ID=
THREADS_APP_SECRET=
# TikTok Login Kit and Content Posting API.
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
# YouTube Shorts. Also used by Postiz for "Sign in with Google".
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# LinkedIn profile or page posting.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# X (Twitter) native app, OAuth 1.0a.
X_API_KEY=
X_API_SECRET=
